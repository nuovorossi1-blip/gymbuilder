{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/GymBuilder.apk",
      "destination": "https://github.com/nuovorossi1-blip/gymbuilder/releases/latest/download/GymBuilder.apk",
      "permanent": false
    }
  ]
}
