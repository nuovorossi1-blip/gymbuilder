<?xml version="1.0" encoding="utf-8"?>
<!-- Notifica custom del timer: sfondo nero pieno, countdown grande colorato per fase
     (giallo = lavoro, blu = riposo). RemoteViews non supporta i temi dell'app, quindi i colori
     sono qui hardcoded invece che in colors.xml, unico punto in cui servono. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#000000"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_timer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notification_timer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B0B0B0"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/notification_timer_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:gravity="end" />

</LinearLayout>
